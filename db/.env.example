# Password for the health_reader Postgres role created by 003_roles_rls.sql.
# Generate a strong random value, e.g.:
#   openssl rand -base64 24
# Avoid a single quote (') in the value -- generate-migrations.py rejects
# one because it would break out of the SQL string literal in the rendered
# CREATE ROLE statement.
#
# Copy this file to db/.env (gitignored) and fill in the value, then run
# python3 generate-migrations.py. The same password goes into mcp/.env's
# DATABASE_URL afterwards -- see docs/SETUP.md.
HEALTH_READER_PASSWORD=
