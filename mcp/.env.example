# Supavisor session-pooler connection string for the health_reader role
# (created by db/003_roles_rls.sql). See docs/SETUP.md for how to create the
# role and enable it for connection pooling in the Supabase dashboard.
DATABASE_URL=postgresql://health_reader.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
