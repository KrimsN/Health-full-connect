# Supavisor session-pooler connection string for the health_reader role
# (created by db/003_roles_rls.sql). The host below is a placeholder shape,
# not a real value to guess at -- copy the exact host (including its aws-N
# shard number) from Dashboard -> Connect -> Direct connection string ->
# Session pooler. Using the wrong shard number fails with a Supavisor
# "tenant/user not found" error that looks like an auth problem but isn't.
DATABASE_URL=postgresql://health_reader.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-N-YOUR_REGION.pooler.supabase.com:5432/postgres
